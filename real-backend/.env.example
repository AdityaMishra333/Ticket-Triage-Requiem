# MongoDB Atlas connection string (same database n8n writes to)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Ticket-Triage
JWT_SECRET=<long-random-string>

# Comma-separated frontend URLs allowed by CORS (not needed when served from the same domain)
CORS_ORIGINS=https://your-frontend.vercel.app

# n8n production webhook (public ngrok URL; use /webhook/, not /webhook-test/)
N8N_WEBHOOK_URL=https://<your-ngrok-domain>/webhook/create-ticket

# Admin approve -> email the customer (Gmail app password)
SMTP_USER=
SMTP_PASS=

# Admin reject -> regenerate the draft with Ollama (must be publicly reachable from Vercel)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
