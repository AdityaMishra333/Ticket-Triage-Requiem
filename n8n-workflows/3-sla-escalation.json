    {
      "parameters": {
        "jsCode": "return $('Older than SLA limit?').all().map(({ json: t }) => {\n  const history = (t.statusHistory || []).map(({ status, note, actor, updatedAt }) => ({ status, note, actor, updatedAt }));\n  history.push({ status: t.status, note: 'Escalated to high urgency: not approved within the SLA limit', actor: 'system', updatedAt: new Date().toISOString() });\n  return { json: { _id: t._id.toString(), statusHistory: history } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
