        "messages": {
          "values": [
            {
              "content": "=Classify this complaint into ONE category: billing, technical, account, delivery, or other. Rate urgency: high, medium, or low. Also pick the ONE department that should handle it: IT, Facilities, HR, Finance, or Customer Support.\n\nComplaint: {{ $('Build ticket record').item.json.problem }}\nItem: {{ $('Build ticket record').item.json.item }}\n\nReply ONLY with JSON, nothing else:\n{\"category\": \"...\", \"urgency\": \"...\", \"department\": \"...\"}"
            }
          ]
        },
        "options": {}
      },
