    {
      "parameters": {
        "jsCode": "const t = $('Find ticket').item.json;\nconst history = (t.statusHistory || []).map(({ status, note, actor, updatedAt }) => ({ status, note, actor, updatedAt }));\nconst now = Date.now();\nconst add = (status, note, actor, offsetMs = 0) => history.push({ status, note, actor, updatedAt: new Date(now + offsetMs).toISOString() });\nconst p = $('Parse classification').item.json;\nadd('classified', `Classified as ${p.category}, ${p.urgency} urgency, routed to ${p.department}`, 'system');\nadd('awaiting_approval', 'AI draft reply ready, awaiting approval', 'system', 1000);\nreturn [{ json: { _id: t._id.toString(), statusHistory: history } }];"
      },
