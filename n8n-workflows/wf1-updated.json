              "name": "urgency",
              "value": "={{ ['high','medium','low'].includes(String((() => { try { return JSON.parse($json.content.replace(/```json/g,'').replace(/```/g,'').trim()); } catch (e) { return {}; } })().urgency || '').toLowerCase()) ? String((() => { try { return JSON.parse($json.content.replace(/```json/g,'').replace(/```/g,'').trim()); } catch (e) { return {}; } })().urgency).toLowerCase() : 'medium' }}",
